# Shadow Lab — Environment Variables
# Copy this to .env and fill in your real values.
# NEVER commit .env to git. Add it to .gitignore.

# For safety, generate a fine-grained HF token scoped ONLY to Read + Inference on your specific Space.
# Do not use a high-privilege write/admin account token.
HF_TOKEN=hf_yourTokenHere

# Must be in the format 'username/space_name' (e.g. 'myuser/my-ocr-space'). Refuses defaults.
HF_SPACE_NAME=your_username/your_space_name
